/*
  RC Robot Arms  (board-independent version)
  -------------------------------------------
  Inputs:  Pin 7 = 3-position switch A (PWM from receiver)
           Pin 8 = 3-position switch B (PWM from receiver)
  Outputs: R_SERVO, L_SERVO (arms), Pin 11 (ACTION_B)

  Arm positions (degrees off CENTER):  UP = +45, CENTER = 0, DOWN = -25
  Servos are mirrored.

  A_HIGH -> ACTION_A : L arm UP, halfway, UP, wait 1s, CENTER (once)
  A_LOW  -> ACTION_B : Pin 11 HIGH
  B_HIGH -> ACTION_C : both arms UP <-> CENTER, looping while held
  B_LOW  -> ACTION_D : L UP + R DOWN, wait 0.5s, L DOWN + R UP, wait 0.5s, looping

  No input / neutral = arms at CENTER.
*/

#include <Servo.h>

// ---------------- DEBUG ----------------
const bool DEBUG = false;             // true = prints pulse widths to Serial Monitor (115200)

// ---------------- PIN SETUP ----------------
const uint8_t PIN_SWITCH_A = 7;
const uint8_t PIN_SWITCH_B = 8;
const uint8_t PIN_ACTION_B = 11;
const uint8_t PIN_R_SERVO  = 9;    // change to match your wiring
const uint8_t PIN_L_SERVO  = 10;   // change to match your wiring

// ---------------- SERVO SETUP ----------------
const float POS_UP     =  45.0;
const float POS_CENTER =   0.0;
const float POS_DOWN   = -25.0;
const float POS_HALF   = (POS_UP + POS_CENTER) / 2.0;

const int   SERVO_MID_ANGLE = 90;     // physical servo angle that equals CENTER
const int   R_DIR = +1;               // flip to -1 if R arm moves the wrong way
const int   L_DIR = -1;               // flip to +1 if L arm moves the wrong way
const float NO_CHANGE = 999.0;        // "leave this servo alone"

// Servo pulse range (Servo library defaults). Adjust if your servos need different values.
const float SERVO_MIN_US = 544.0;     // pulse for 0 degrees
const float SERVO_MAX_US = 2400.0;    // pulse for 180 degrees

// ---------------- SERVO SPEEDS (degrees per second) ----------------
// Lower = slower.  ~45 slow, ~90 moderate, ~180 fast
const float SPEED_A      = 180.0;     // ACTION_A
const float SPEED_C      = 90.0;     // ACTION_C
const float SPEED_D      = 160.0;     // ACTION_D
const float SPEED_RETURN = 120.0;     // returning to CENTER when a switch is released

float servoSpeed = SPEED_RETURN;      // speed currently in use

// ---------------- RC THRESHOLDS ----------------
const uint16_t RC_HIGH = 1700;        // pulse > this  = HIGH
const uint16_t RC_LOW  = 1300;        // pulse < this  = LOW
const uint16_t PULSE_MIN_VALID = 800; // pulses outside this range are ignored
const uint16_t PULSE_MAX_VALID = 2300;
const uint32_t SIGNAL_TIMEOUT_US = 100000UL;
const uint32_t DEBOUNCE_MS = 100;     // switch change must hold this long

// ---------------- SWITCH STATES ----------------
const uint8_t SW_NONE = 0;            // middle position or no signal
const uint8_t SW_LOW  = 1;
const uint8_t SW_HIGH = 2;

// ---------------- RC PULSE READING (polling) ----------------
const uint8_t PIN_SW[2] = { PIN_SWITCH_A, PIN_SWITCH_B };
bool     prevLevel[2] = { false, false };
uint32_t riseT[2]     = { 0, 0 };
uint32_t lastT[2]     = { 0, 0 };
uint16_t widthUs[2]   = { 0, 0 };     // filtered (median of last 3) pulse width
uint16_t badCount[2]  = { 0, 0 };     // rejected pulses (debug info)

uint16_t hist[2][3]   = { {1500, 1500, 1500}, {1500, 1500, 1500} };
uint8_t  histIdx[2]   = { 0, 0 };

uint8_t  stableState[2] = { SW_NONE, SW_NONE };
uint8_t  candState[2]   = { SW_NONE, SW_NONE };
uint32_t candSince[2]   = { 0, 0 };

uint16_t median3(uint16_t a, uint16_t b, uint16_t c) {
  if (a > b) { uint16_t t = a; a = b; b = t; }
  if (b > c) { uint16_t t = b; b = c; c = t; }
  if (a > b) { b = a; }
  return b;
}

void pollInputs() {
  for (uint8_t i = 0; i < 2; i++) {
    bool lvl = digitalRead(PIN_SW[i]);
    if (lvl && !prevLevel[i]) {
      riseT[i] = micros();
    } else if (!lvl && prevLevel[i]) {
      uint32_t now = micros();
      uint32_t w = now - riseT[i];
      if (w >= PULSE_MIN_VALID && w <= PULSE_MAX_VALID) {
        hist[i][histIdx[i]] = (uint16_t)w;            // good pulse
        histIdx[i] = (histIdx[i] + 1) % 3;
        widthUs[i] = median3(hist[i][0], hist[i][1], hist[i][2]);
        lastT[i] = now;
      } else {
        badCount[i]++;                // missed an edge: throw it away
      }
    }
    prevLevel[i] = lvl;
  }
}

uint8_t readSwitch(uint8_t i) {
  uint8_t raw = SW_NONE;
  if (micros() - lastT[i] <= SIGNAL_TIMEOUT_US) {
    if (widthUs[i] > RC_HIGH) raw = SW_HIGH;
    else if (widthUs[i] > 0 && widthUs[i] < RC_LOW) raw = SW_LOW;
  }
  // debounce: raw state must stay the same for DEBOUNCE_MS
  if (raw != candState[i]) {
    candState[i] = raw;
    candSince[i] = millis();
  }
  if (millis() - candSince[i] >= DEBOUNCE_MS) stableState[i] = candState[i];
  return stableState[i];
}

// ---------------- SERVO CONTROL (smooth, non-blocking) ----------------
Servo rServo, lServo;
float rPos = POS_CENTER, lPos = POS_CENTER;
float rTarget = POS_CENTER, lTarget = POS_CENTER;
uint32_t lastServoUpdate = 0;
int lastUsR = 0, lastUsL = 0;         // last pulse sent to each servo

int angleToUs(float angleDeg) {
  return (int)(SERVO_MIN_US + angleDeg * (SERVO_MAX_US - SERVO_MIN_US) / 180.0 + 0.5);
}

void writeServos() {
  int r = angleToUs(SERVO_MID_ANGLE + R_DIR * rPos);
  int l = angleToUs(SERVO_MID_ANGLE + L_DIR * lPos);
  if (r != lastUsR) { rServo.writeMicroseconds(r); lastUsR = r; }   // only write on change
  if (l != lastUsL) { lServo.writeMicroseconds(l); lastUsL = l; }
}

float stepToward(float cur, float target, float maxStep) {
  if (fabs(target - cur) <= maxStep) return target;
  return cur + (target > cur ? maxStep : -maxStep);
}

void updateServos() {
  uint32_t now = micros();
  float dt = (now - lastServoUpdate) / 1000000.0;
  lastServoUpdate = now;
  float maxStep = servoSpeed * dt;
  rPos = stepToward(rPos, rTarget, maxStep);
  lPos = stepToward(lPos, lTarget, maxStep);
  writeServos();
}

bool servosArrived() { return rPos == rTarget && lPos == lTarget; }

void setTargets(float l, float r) {
  if (l != NO_CHANGE) lTarget = l;
  if (r != NO_CHANGE) rTarget = r;
}

// ---------------- SEQUENCE ENGINE ----------------
struct Step { float l; float r; uint16_t holdMs; };

const Step SEQ_A[] = {                // ACTION_A (R untouched)
  { POS_UP,     NO_CHANGE, 0    },
  { POS_HALF,   NO_CHANGE, 0    },
  { POS_UP,     NO_CHANGE, 1000 },
  { POS_CENTER, NO_CHANGE, 0    },
};
const Step SEQ_C[] = {                // ACTION_C
  { POS_UP,     POS_UP,     0 },
  { POS_CENTER, POS_CENTER, 0 },
};
const Step SEQ_D[] = {                // ACTION_D
  { POS_UP,   POS_DOWN, 500 },
  { POS_DOWN, POS_UP,   500 },
};

const uint8_t ACT_NONE = 0;
const uint8_t ACT_A    = 1;
const uint8_t ACT_C    = 2;
const uint8_t ACT_D    = 3;

const Step* seq = nullptr;
uint8_t seqLen = 0, seqIdx = 0;
bool seqLoop = false, seqHolding = false;
uint32_t holdStart = 0;
uint8_t currentAction = ACT_NONE;

void applyStep() {
  setTargets(seq[seqIdx].l, seq[seqIdx].r);
  seqHolding = false;
}

void startAction(uint8_t id) {
  currentAction = id;
  seqIdx = 0;
  if (id == ACT_A)      { seq = SEQ_A; seqLen = sizeof(SEQ_A) / sizeof(Step); seqLoop = false; servoSpeed = SPEED_A; }
  else if (id == ACT_C) { seq = SEQ_C; seqLen = sizeof(SEQ_C) / sizeof(Step); seqLoop = true;  servoSpeed = SPEED_C; }
  else if (id == ACT_D) { seq = SEQ_D; seqLen = sizeof(SEQ_D) / sizeof(Step); seqLoop = true;  servoSpeed = SPEED_D; }
  else return;
  applyStep();
}

void stopAction() {                   // return to CENTER
  currentAction = ACT_NONE;
  seq = nullptr;
  servoSpeed = SPEED_RETURN;
  setTargets(POS_CENTER, POS_CENTER);
}

void updateSequence() {
  if (currentAction == ACT_NONE) return;
  if (!seqHolding) {
    if (!servosArrived()) return;
    seqHolding = true;
    holdStart = millis();
  }
  if (millis() - holdStart < seq[seqIdx].holdMs) return;

  seqIdx++;
  if (seqIdx >= seqLen) {
    if (seqLoop) seqIdx = 0;
    else { stopAction(); return; }    // one-shot finished
  }
  applyStep();
}

// ---------------- MAIN ----------------
bool aLatch = false;   // ACTION_A fires once per switch throw
uint32_t lastPrint = 0;

void setup() {
  if (DEBUG) Serial.begin(115200);

  pinMode(PIN_SWITCH_A, INPUT);
  pinMode(PIN_SWITCH_B, INPUT);
  pinMode(PIN_ACTION_B, OUTPUT);
  digitalWrite(PIN_ACTION_B, LOW);

  rServo.attach(PIN_R_SERVO);
  lServo.attach(PIN_L_SERVO);
  writeServos();                      // start at CENTER
  lastServoUpdate = micros();
}

void loop() {
  pollInputs();
  uint8_t a = readSwitch(0);
  uint8_t b = readSwitch(1);

  if (DEBUG && millis() - lastPrint > 250) {
    lastPrint = millis();
    Serial.print("A="); Serial.print(widthUs[0]);
    Serial.print(" B="); Serial.print(widthUs[1]);
    Serial.print(" stateA="); Serial.print(a);
    Serial.print(" stateB="); Serial.print(b);
    Serial.print(" badA="); Serial.print(badCount[0]);
    Serial.print(" badB="); Serial.print(badCount[1]);
    Serial.print(" action="); Serial.println(currentAction);
  }

  // ACTION_B: pin 11 follows A_LOW
  digitalWrite(PIN_ACTION_B, a == SW_LOW ? HIGH : LOW);

  if (a != SW_HIGH) aLatch = false;   // re-arm ACTION_A

  if (currentAction == ACT_A) {
    // ACTION_A is a one-shot: let it finish
  } else if (a == SW_HIGH && !aLatch) {
    aLatch = true;
    startAction(ACT_A);
  } else if (b == SW_HIGH) {
    if (currentAction != ACT_C) startAction(ACT_C);
  } else if (b == SW_LOW) {
    if (currentAction != ACT_D) startAction(ACT_D);
  } else if (currentAction != ACT_NONE) {
    stopAction();                     // trigger released -> CENTER
  }

  updateSequence();
  updateServos();
}
